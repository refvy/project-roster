generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organiser {
  id         String      @id @default(cuid())
  email      String      @unique
  createdAt  DateTime    @default(now())
  magicLinks MagicLink[]
  sessions   Session[]
  matchdays  Matchday[]
}

model MagicLink {
  id          String     @id @default(cuid())
  organiserId String
  organiser   Organiser  @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  tokenHash   String     @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([organiserId])
}

model Session {
  id          String    @id @default(cuid())
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([organiserId])
}

/// Positions snapshot as JSON on create. Organiser pitch is view-only first-fit.
model Matchday {
  id          String    @id @default(cuid())
  publicId    String    @unique
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  title       String
  whenWhere   String    @default("")
  /// Asia/Bangkok wall time stored as UTC. Null = TBD.
  startsAt    DateTime?
  endsAt      DateTime?
  /// False = date only (time TBD). Timed rows are true.
  hasTime     Boolean   @default(false)
  place       String?
  venue       String?
  /// Plain http(s) URL only. No embed.
  mapUrl      String?
  sport       String    @default("football")
  formation   String    @default("4-3-3")
  positions   Json
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  status      MatchdayStatus @default(LIVE)
  /// LINE cache-bust token. The 5am BKK OG refresh cron bumps this.
  ogBust      String    @default("0")
  rsvps       Rsvp[]
  lineups     Lineup[]

  @@index([organiserId])
}

/// Manager football XI snapshot. Names freeze at Save; later roster edits do not hollow the card.
model Lineup {
  id         String   @id @default(cuid())
  matchdayId String
  matchday   Matchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  name       String
  formation  String
  /// [{ id, key, rsvpId, name }] at save.
  slots      Json
  /// Going − XI at save: [{ rsvpId, name }].
  bench      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([matchdayId])
}

enum MatchdayStatus {
  LIVE
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  GOING
  OUT
}

model Rsvp {
  id             String     @id @default(cuid())
  matchdayId     String
  matchday       Matchday   @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  guestId        String
  addedByGuestId String?
  addedByName    String?
  name           String
  status         RsvpStatus
  positionKey    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([matchdayId, guestId])
  @@index([matchdayId, status])
  @@index([addedByGuestId])
}
